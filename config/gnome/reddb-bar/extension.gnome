import Clutter from 'gi://Clutter';
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import GObject from 'gi://GObject';
import St from 'gi://St';

import {Extension} from 'resource:///org/gnome/shell/extensions/extension.js';
import * as Main from 'resource:///org/gnome/shell/ui/main.js';
import * as PanelMenu from 'resource:///org/gnome/shell/ui/panelMenu.js';
import * as PopupMenu from 'resource:///org/gnome/shell/ui/popupMenu.js';

// Replaced with the content fingerprint by red-dev when installing the bar.
// Unlike metadata read from disk, this identifies the JavaScript actually loaded.
const RUNTIME_REVISION = '__RED_DEV_BAR_REVISION__';
const RUNTIME_PATH = '/io/reddb/RedDevDesktop';
const RUNTIME_INTERFACE = `<node><interface name="io.reddb.RedDevDesktop">
  <method name="Get"><arg type="s" name="status" direction="out"/></method>
</interface></node>`;
const NAMED_TRAYS = ['RedRouter', 'Redskilled'];

// The user services red-dev installs or depends on. Read from the systemd
// user manager over D-Bus, so the bar can say when one of them is down instead
// of leaving a dead tray icon to be noticed hours later.
const WATCHED_UNITS = ['redskilled*.service', 'red-router*.service', 'dit.service', 'red-dev-*.service'];
const SERVICE_POLL_SECONDS = 10;
const SYSTEMD_NAME = 'org.freedesktop.systemd1';
const SYSTEMD_PATH = '/org/freedesktop/systemd1';
const SYSTEMD_MANAGER = 'org.freedesktop.systemd1.Manager';
const UPDATE_POLL_SECONDS = 60;
const RESOURCE_POLL_SECONDS = 30;
const GIB = 1024 * 1024 * 1024;

const MENU_WINDOW = [
  '--class', 'red-dev-menu,red-dev-menu',
  '--title', 'red-dev',
  '--option', 'window.dimensions.columns=68',
  '--option', 'window.dimensions.lines=25',
  '--option', 'window.decorations="None"',
  '--option', 'window.dynamic_title=false',
  '--option', 'window.opacity=0.97',
  '--option', 'window.padding.x=12',
  '--option', 'window.padding.y=10',
  '--option', 'scrolling.history=0',
];

function firstExecutable(paths) {
  return paths.find(path => GLib.file_test(path, GLib.FileTest.IS_EXECUTABLE)) ?? paths.at(-1);
}

function defaultAgentLabel(key) {
  const labels = {
    'claude-code': 'Claude Code',
    codex: 'Codex CLI',
    redcode: 'RedCode',
    opencode: 'RedCode',
    gemini: 'Gemini CLI',
    pi: 'Pi',
    'oh-my-pi': 'Oh My Pi',
    hermes: 'Hermes Agent',
    muse: 'Muse',
    openclaw: 'OpenClaw',
  };
  return typeof key === 'string' && key.length > 0 ? labels[key] ?? key : 'Agent';
}

function redDevExecutable() {
  const home = GLib.get_home_dir();
  return firstExecutable([
    `${home}/.local/share/mise/installs/red-dev/latest/red-dev`,
    `${home}/.local/share/mise/shims/red-dev`,
    `${home}/.local/bin/red-dev`,
    'red-dev',
  ]);
}

function command(...args) {
  const redDev = redDevExecutable();
  const terminal = firstExecutable(['/usr/bin/alacritty', 'alacritty']);

  try {
    Gio.Subprocess.new(
      [terminal, ...(args[0] === 'menu' ? MENU_WINDOW : []), '-e', redDev, ...args],
      Gio.SubprocessFlags.NONE,
    );
  } catch (error) {
    console.error(`RedDB Menu Bar could not start red-dev ${args.join(' ')}: ${error.message}`);
  }
}

function herdr() {
  const home = GLib.get_home_dir();
  const executable = firstExecutable([
    `${home}/.local/share/mise/shims/herdr`,
    `${home}/.local/bin/herdr`,
    'herdr',
  ]);
  const terminal = firstExecutable(['/usr/bin/alacritty', 'alacritty']);
  try {
    Gio.Subprocess.new([terminal, '-e', executable], Gio.SubprocessFlags.NONE);
  } catch (error) {
    console.error(`RedDB Menu Bar could not start herdr: ${error.message}`);
  }
}

function openDiagnosticLog(app) {
  const home = GLib.get_home_dir();
  const executable = firstExecutable([
    `${home}/.local/share/mise/shims/red-dev`, `${home}/.local/bin/red-dev`, 'red-dev',
  ]);
  try {
    const child = Gio.Subprocess.new(
      [executable, 'logs', '--app', app, '--open'],
      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE,
    );
    child.communicate_utf8_async(null, null, (process, result) => {
      try {
        const [, stdout, stderr] = process.communicate_utf8_finish(result);
        if (!process.get_successful())
          Main.notifyError('Could not open log', (stderr || stdout || app).trim().slice(0, 512));
      } catch (error) {
        Main.notifyError('Could not open log', error.message);
      }
    });
  } catch (error) {
    Main.notifyError('Could not open log', error.message);
  }
}

// One word for how a unit is doing. PURE.
//
// `failed` is a unit systemd gave up on; `auto-restart` is one that is
// crash-looping and will be `failed` shortly. A oneshot that finished
// (`inactive` or `active (exited)`) is healthy, so neither state is a problem.
function unitHealth(unit) {
  if (unit.active === 'failed')
    return 'failed';
  if (unit.active === 'activating' && unit.sub === 'auto-restart')
    return 'restarting';
  return 'ok';
}

function serviceName(unit) {
  return unit.replace(/\.service$/, '');
}

const HEALTH_GLYPH = {failed: '✕', restarting: '↻', ok: '●'};

// A live tail of one unit's journal in its own terminal window. The unit name
// comes from systemd and is passed as an argv element, never through a shell.
function openServiceLog(unit) {
  const terminal = firstExecutable(['/usr/bin/alacritty', 'alacritty']);
  try {
    Gio.Subprocess.new([
      terminal,
      '--class', 'red-dev-log,red-dev-log',
      '--title', `${serviceName(unit)} log`,
      '-e', 'journalctl', '--user', '-u', unit, '-f', '-n', '200', '--output=short-iso',
    ], Gio.SubprocessFlags.NONE);
  } catch (error) {
    Main.notifyError('Could not open log', error.message);
  }
}

// Watches WATCHED_UNITS through the user manager's D-Bus API. Every call is
// asynchronous, so nothing here blocks GNOME Shell's main loop, and a missing
// or slow systemd only leaves the last known state on screen.
class ServiceMonitor {
  constructor(onChange) {
    this._onChange = onChange;
    this._units = [];
    this._notified = new Set();
    this._busy = false;
    this._destroyed = false;
    this._poll();
    this._source = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, SERVICE_POLL_SECONDS, () => {
      this._poll();
      return GLib.SOURCE_CONTINUE;
    });
  }

  _call(method, args, replyType, done) {
    Gio.DBus.session.call(
      SYSTEMD_NAME, SYSTEMD_PATH, SYSTEMD_MANAGER, method, args, replyType,
      Gio.DBusCallFlags.NONE, 5000, null,
      (connection, result) => {
        if (this._destroyed)
          return;
        try {
          done(null, connection.call_finish(result));
        } catch (error) {
          done(error, null);
        }
      });
  }

  _poll() {
    if (this._busy)
      return;
    this._busy = true;
    this._call(
      'ListUnitsByPatterns',
      new GLib.Variant('(asas)', [[], WATCHED_UNITS]),
      new GLib.VariantType('(a(ssssssouso))'),
      (error, reply) => {
        this._busy = false;
        if (error) {
          console.error(`RedDB Menu Bar could not read the user services: ${error.message}`);
          return;
        }
        const [rows] = reply.deepUnpack();
        this._apply(rows.map(row => ({
          name: row[0], description: row[1], load: row[2], active: row[3], sub: row[4],
        })).filter(unit => unit.load === 'loaded').sort((a, b) => a.name.localeCompare(b.name)));
      });
  }

  _apply(units) {
    // Say so once per failure, and again only if it recovers and fails anew.
    // A unit already broken when the session starts is announced too: that is
    // exactly the one nobody has looked at.
    for (const unit of units) {
      const failed = unitHealth(unit) === 'failed';
      if (failed && !this._notified.has(unit.name)) {
        this._notified.add(unit.name);
        Main.notify(`${serviceName(unit.name)} is not running`,
          'Open the RedDB menu, Services, to see its log or restart it.');
      } else if (!failed) {
        this._notified.delete(unit.name);
      }
    }
    this._units = units;
    this._onChange(units);
  }

  // A unit that hit its start limit refuses `start` until it is reset.
  restart(name) {
    this._call('ResetFailedUnit', new GLib.Variant('(s)', [name]), null, () => {
      this._call('RestartUnit', new GLib.Variant('(ss)', [name, 'replace']),
        new GLib.VariantType('(o)'), error => {
          if (error)
            Main.notifyError(`Could not restart ${serviceName(name)}`, error.message);
          this._poll();
        });
    });
  }

  status() {
    return this._units.map(unit => ({name: unit.name, active: unit.active, sub: unit.sub, health: unitHealth(unit)}));
  }

  destroy() {
    this._destroyed = true;
    if (this._source)
      GLib.source_remove(this._source);
    this._source = 0;
  }
}

function stateFile(name) {
  const base = GLib.getenv('XDG_STATE_HOME') || `${GLib.get_home_dir()}/.local/state`;
  return `${base}/red-dev/${name}`;
}

function readText(path) {
  try {
    const [ok, bytes] = GLib.file_get_contents(path);
    return ok ? new TextDecoder().decode(bytes) : null;
  } catch (error) {
    return null;
  }
}

// The curated tools that are behind, as the watch tick last recorded them.
// red-dev writes this file; the bar only reads it, because the Shell must
// not touch the network and does not know which tools red-dev curates.
function readUpdates() {
  const text = readText(stateFile('updates.json'));
  if (text === null)
    return [];
  try {
    const outdated = JSON.parse(text).outdated;
    return Array.isArray(outdated)
      ? outdated.filter(tool => tool && typeof tool.name === 'string' && typeof tool.latest === 'string')
      : [];
  } catch (error) {
    return [];
  }
}

// How tight a resource is. PURE. The memory thresholds are the ones
// `red-dev doctor` reports (under 15% available warns, under 5% is critical);
// the disk ones scale down to a small SSD and are absolute on a large one.
function memoryLevel(availableKiB, totalKiB) {
  if (!(totalKiB > 0))
    return 'ok';
  const free = availableKiB / totalKiB;
  return free < 0.05 ? 'critical' : free < 0.15 ? 'warning' : 'ok';
}

function diskLevel(freeBytes, sizeBytes) {
  if (!(sizeBytes > 0))
    return 'ok';
  const ratio = freeBytes / sizeBytes;
  if (ratio < 0.05 || freeBytes < 5 * GIB)
    return 'critical';
  if (ratio < 0.10 || freeBytes < 10 * GIB)
    return 'warning';
  return 'ok';
}

function gib(bytes) {
  const value = bytes / GIB;
  return `${value.toFixed(value < 10 ? 1 : 0)} GiB`;
}

function readMemory() {
  const text = readText('/proc/meminfo');
  if (text === null)
    return null;
  const field = name => {
    const match = new RegExp(`^${name}:\\s+(\\d+) kB`, 'm').exec(text);
    return match ? Number(match[1]) : null;
  };
  const total = field('MemTotal');
  const available = field('MemAvailable');
  return total && available !== null ? {totalKiB: total, availableKiB: available} : null;
}

// Reads updates.json now and then. A plain file, so there is no subprocess
// and no network here.
class UpdateWatcher {
  constructor(onChange) {
    this._onChange = onChange;
    this._notified = '';
    this._read();
    this._source = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, UPDATE_POLL_SECONDS, () => {
      this._read();
      return GLib.SOURCE_CONTINUE;
    });
  }

  _read() {
    const tools = readUpdates();
    // Said once per set of pending versions, so a newer release is news again
    // and an update left pending is not repeated.
    const signature = tools.map(tool => `${tool.name}@${tool.latest}`).join(',');
    if (tools.length > 0 && signature !== this._notified) {
      this._notified = signature;
      Main.notify('Updates available',
        `${tools.map(tool => `${tool.name} ${tool.latest}`).join(', ')} — RedDB menu, Update workstation.`);
    } else if (tools.length === 0) {
      this._notified = '';
    }
    this._tools = tools;
    this._onChange(tools);
  }

  status() {
    return this._tools ?? [];
  }

  destroy() {
    if (this._source)
      GLib.source_remove(this._source);
    this._source = 0;
  }
}

// Memory from /proc/meminfo and free space on the home filesystem. The disk
// query is asynchronous; meminfo is a few hundred bytes of procfs.
class ResourceMonitor {
  constructor(onChange) {
    this._onChange = onChange;
    this._levels = {memory: 'ok', disk: 'ok'};
    this._state = {memory: null, disk: null};
    this._destroyed = false;
    this._poll();
    this._source = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, RESOURCE_POLL_SECONDS, () => {
      this._poll();
      return GLib.SOURCE_CONTINUE;
    });
  }

  _poll() {
    const memory = readMemory();
    if (memory)
      this._state.memory = {...memory, level: memoryLevel(memory.availableKiB, memory.totalKiB)};
    try {
      Gio.File.new_for_path(GLib.get_home_dir()).query_filesystem_info_async(
        'filesystem::free,filesystem::size', GLib.PRIORITY_DEFAULT, null,
        (file, result) => {
          if (this._destroyed)
            return;
          try {
            const info = file.query_filesystem_info_finish(result);
            const freeBytes = info.get_attribute_uint64('filesystem::free');
            const sizeBytes = info.get_attribute_uint64('filesystem::size');
            this._state.disk = {freeBytes, sizeBytes, level: diskLevel(freeBytes, sizeBytes)};
          } catch (error) {
            console.error(`RedDB Menu Bar could not read the disk: ${error.message}`);
          }
          this._publish();
        });
    } catch (error) {
      console.error(`RedDB Menu Bar could not read the disk: ${error.message}`);
      this._publish();
    }
  }

  _publish() {
    // Only the step into "critical" interrupts anybody; a warning is the
    // indicator in the panel, and staying critical is not said again.
    const {memory, disk} = this._state;
    if (memory && memory.level === 'critical' && this._levels.memory !== 'critical') {
      Main.notify('Memory is almost exhausted',
        `${Math.round(memory.availableKiB / memory.totalKiB * 100)}% available. Close something, or see what is using it from the RedDB menu.`);
    }
    if (disk && disk.level === 'critical' && this._levels.disk !== 'critical') {
      Main.notify('The disk is almost full', `${gib(disk.freeBytes)} free on the home filesystem.`);
    }
    this._levels = {memory: memory?.level ?? 'ok', disk: disk?.level ?? 'ok'};
    this._onChange(this._state);
  }

  status() {
    return this._state;
  }

  destroy() {
    this._destroyed = true;
    if (this._source)
      GLib.source_remove(this._source);
    this._source = 0;
  }
}

function openInTerminal(argv) {
  const terminal = firstExecutable(['/usr/bin/alacritty', 'alacritty']);
  try {
    Gio.Subprocess.new([terminal, ...argv], Gio.SubprocessFlags.NONE);
  } catch (error) {
    Main.notifyError('Could not open the terminal', error.message);
  }
}

function item(menu, label, icon, action) {
  const row = new PopupMenu.PopupImageMenuItem(label, icon);
  row.connect('activate', action);
  menu.addMenuItem(row);
  return row;
}

function themeMenu(menu) {
  menu.box.add_style_class_name('reddb-popup-menu');
}

// PanelMenu's primary-click behavior varies across Shell/AppIndicator
// combinations. Make the desktop contract explicit: secondary-clicking a
// RedDB panel entry always opens its menu, where the diagnostic action lives.
function openMenuOnSecondaryClick(button) {
  return button.connect('button-press-event', (_actor, event) => {
    if (event.get_button() !== 3)
      return Clutter.EVENT_PROPAGATE;
    button.menu.open();
    return Clutter.EVENT_STOP;
  });
}

const RedDbMenu = GObject.registerClass(class RedDbMenu extends PanelMenu.Button {
  _init(extension, services = {}) {
    super._init(0.0, 'Menu');
    this._services = services;
    this._servicesSignature = '';
    this.add_style_class_name('reddb-panel-button');
    this.add_style_class_name('reddb-brand-button');
    themeMenu(this.menu);
    this._secondaryClickId = openMenuOnSecondaryClick(this);

    const box = new St.BoxLayout({style_class: 'reddb-brand'});
    box.add_child(new St.Icon({
      gicon: Gio.icon_new_for_string(`${extension.path}/reddb-icon.svg`),
      style_class: 'reddb-brand-icon',
    }));
    box.add_child(new St.Label({text: 'Menu', y_align: 2}));
    // Only there when something is wrong: a healthy machine shows nothing.
    this._badge = new St.Label({text: '●', y_align: 2, style_class: 'reddb-health-badge'});
    this._badge.hide();
    box.add_child(this._badge);
    // "RAM 6% free" or "Disk 4.2 GiB free", present only while it is tight.
    this._pressure = new St.Label({text: '', y_align: 2, style_class: 'reddb-pressure'});
    this._pressure.hide();
    box.add_child(this._pressure);
    this.add_child(box);

    item(this.menu, 'Applications', 'view-app-grid-symbolic', () => Main.overview.showApps());
    item(this.menu, 'red-dev menu', 'open-menu-symbolic', () => command('menu'));
    this.menu.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
    item(this.menu, 'Default agent', 'system-run-symbolic', () => command('agents', 'run'));
    item(this.menu, 'Agent multiplexer', 'view-grid-symbolic', () => herdr());
    this.menu.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
    this._servicesItem = new PopupMenu.PopupSubMenuMenuItem('Services');
    this.menu.addMenuItem(this._servicesItem);
    this._memoryItem = item(this.menu, 'Memory', 'utilities-system-monitor-symbolic',
      () => openInTerminal(['-e', 'btop']));
    this._diskItem = item(this.menu, 'Disk', 'drive-harddisk-symbolic',
      () => openInTerminal(['--hold', '-e', 'duf']));
    this.menu.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());
    item(this.menu, 'Doctor', 'emblem-system-symbolic', () => command('doctor'));
    item(this.menu, 'Open red-dev log', 'text-x-generic-symbolic', () => openDiagnosticLog('red-dev'));
    // The rest of the logs, for the things that have one of their own.
    const logs = new PopupMenu.PopupSubMenuMenuItem('More logs');
    for (const [label, app] of [['RedRouter', 'red-router'], ['Redskilled', 'redskilled'],
      ['Resource guard', 'workloads']]) {
      const row = new PopupMenu.PopupMenuItem(label);
      row.connect('activate', () => openDiagnosticLog(app));
      logs.menu.addMenuItem(row);
    }
    this.menu.addMenuItem(logs);
    item(this.menu, 'Apps', 'application-x-executable-symbolic', () => command('apps'));
    this._updateItem = item(this.menu, 'Update workstation', 'software-update-available-symbolic',
      () => command('update'));
  }

  setUpdates(tools) {
    this._updateItem.label.set_text(
      tools.length === 0 ? 'Update workstation' : `Update workstation — ${tools.length} available`);
  }

  setResources({memory, disk}) {
    if (memory) {
      this._memoryItem.label.set_text(
        `Memory  ·  ${gib(memory.availableKiB * 1024)} free of ${gib(memory.totalKiB * 1024)}`);
    }
    if (disk)
      this._diskItem.label.set_text(`Disk  ·  ${gib(disk.freeBytes)} free`);

    // The tightest one, said in the panel; nothing at all when neither is.
    const tight = [
      memory && memory.level !== 'ok' && {
        level: memory.level, rank: memory.availableKiB / memory.totalKiB,
        text: `RAM ${Math.round(memory.availableKiB / memory.totalKiB * 100)}% free`,
      },
      disk && disk.level !== 'ok' && {
        level: disk.level, rank: disk.freeBytes / disk.sizeBytes, text: `Disk ${gib(disk.freeBytes)} free`,
      },
    ].filter(Boolean).sort((a, b) =>
      (a.level === b.level ? a.rank - b.rank : a.level === 'critical' ? -1 : 1))[0];
    this._pressure.remove_style_class_name('reddb-health-failed');
    this._pressure.remove_style_class_name('reddb-health-restarting');
    if (tight) {
      this._pressure.set_text(tight.text);
      this._pressure.add_style_class_name(tight.level === 'critical' ? 'reddb-health-failed' : 'reddb-health-restarting');
      this._pressure.show();
    } else {
      this._pressure.hide();
    }
  }

  setServices(units) {
    const signature = JSON.stringify(units.map(unit => [unit.name, unitHealth(unit)]));
    if (signature === this._servicesSignature)
      return;
    this._servicesSignature = signature;

    const problems = units.filter(unit => unitHealth(unit) !== 'ok');
    const worst = problems.some(unit => unitHealth(unit) === 'failed') ? 'failed' : 'restarting';
    this._badge.remove_style_class_name('reddb-health-failed');
    this._badge.remove_style_class_name('reddb-health-restarting');
    if (problems.length > 0) {
      this._badge.add_style_class_name(`reddb-health-${worst}`);
      this._badge.show();
    } else {
      this._badge.hide();
    }

    this._servicesItem.label.set_text(
      problems.length === 0 ? 'Services' : `Services — ${problems.length} not running`);
    const submenu = this._servicesItem.menu;
    submenu.removeAll();
    for (const unit of units) {
      const health = unitHealth(unit);
      const row = new PopupMenu.PopupMenuItem(
        `${HEALTH_GLYPH[health]}  ${serviceName(unit.name)}  ·  ${unit.active === 'active' ? unit.sub : unit.active}`);
      row.label.add_style_class_name(`reddb-health-${health}`);
      row.connect('activate', () => this._services.log?.(unit.name));
      submenu.addMenuItem(row);
      if (health !== 'ok') {
        const restart = new PopupMenu.PopupMenuItem(`↻  Restart ${serviceName(unit.name)}`);
        restart.connect('activate', () => this._services.restart?.(unit.name));
        submenu.addMenuItem(restart);
      }
    }
    if (units.length === 0)
      submenu.addMenuItem(new PopupMenu.PopupMenuItem('No RedDB services installed'));
  }
});

const WorkspaceMenu = GObject.registerClass(class WorkspaceMenu extends PanelMenu.Button {
  _init() {
    super._init(0.0, 'Workspaces');
    this.add_style_class_name('reddb-panel-button');
    themeMenu(this.menu);
    this._dots = new St.BoxLayout({style_class: 'reddb-workspaces'});
    this.add_child(this._dots);
    this._signals = [
      global.workspace_manager.connect('active-workspace-changed', () => this._refresh()),
      global.workspace_manager.connect('notify::n-workspaces', () => this._refresh()),
    ];
    this._refresh();
  }

  _refresh() {
    const manager = global.workspace_manager;
    const active = manager.get_active_workspace_index();
    for (const child of this._dots.get_children())
      child.destroy();
    for (let i = 0; i < manager.n_workspaces; i++) {
      this._dots.add_child(new St.Label({
        text: i === active ? '●' : '○',
        style_class: i === active ? 'reddb-workspace-active' : 'reddb-workspace-inactive',
        y_align: 2,
      }));
    }
    this.menu.removeAll();
    for (let i = 0; i < manager.n_workspaces; i++) {
      const row = new PopupMenu.PopupMenuItem(`Workspace ${i + 1}`);
      row.setOrnament(i === active ? PopupMenu.Ornament.DOT : PopupMenu.Ornament.NONE);
      row.connect('activate', () => manager.get_workspace_by_index(i).activate(global.get_current_time()));
      this.menu.addMenuItem(row);
    }
  }

  destroy() {
    for (const id of this._signals)
      global.workspace_manager.disconnect(id);
    super.destroy();
  }
});

const AgentsMenu = GObject.registerClass(class AgentsMenu extends PanelMenu.Button {
  _init() {
    const label = defaultAgentLabel();
    super._init(0.0, label);
    this.add_style_class_name('reddb-panel-button');
    themeMenu(this.menu);
    this._secondaryClickId = openMenuOnSecondaryClick(this);
    const box = new St.BoxLayout({style_class: 'reddb-agents'});
    box.add_child(new St.Icon({icon_name: 'system-run-symbolic', style_class: 'reddb-agents-icon'}));
    this._agentLabel = new St.Label({text: label, y_align: 2});
    box.add_child(this._agentLabel);
    this.add_child(box);

    this._launchRow = item(this.menu, `Launch ${label}`, 'media-playback-start-symbolic', () => command('agents', 'run'));
    item(this.menu, 'Open multiplexer', 'view-grid-symbolic', () => herdr());
    item(this.menu, 'Choose agents', 'preferences-system-symbolic', () => command('agents'));
    item(this.menu, 'Open RedCode log', 'text-x-generic-symbolic', () => openDiagnosticLog('redcode'));
    this._configProcess = null;
    this._configTimeout = 0;
    this._destroyed = false;
    this._menuSignal = this.menu.connect('open-state-changed', (_menu, open) => {
      if (open)
        this._refreshAgent();
    });
    this._refreshAgent();
  }

  _refreshAgent() {
    if (this._configProcess || this._destroyed)
      return;
    try {
      const proc = Gio.Subprocess.new([redDevExecutable(), 'config', '--json'],
        Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE);
      this._configProcess = proc;
      this._configTimeout = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, 5, () => {
        this._configTimeout = 0;
        proc.force_exit();
        return GLib.SOURCE_REMOVE;
      });
      proc.communicate_utf8_async(null, null, (child, result) => {
        if (this._configTimeout)
          GLib.source_remove(this._configTimeout);
        this._configTimeout = 0;
        this._configProcess = null;
        try {
          const [, stdout] = child.communicate_utf8_finish(result);
          if (this._destroyed || !child.get_successful())
            return;
          const label = defaultAgentLabel(JSON.parse(stdout).preferences?.defaultAgent);
          this._agentLabel.text = label;
          this._launchRow.label.text = `Launch ${label}`;
          this.accessible_name = label;
        } catch (error) {
          if (!this._destroyed)
            console.error(`RedDB Menu Bar could not read the Default agent: ${error.message}`);
        }
      });
    } catch (error) {
      console.error(`RedDB Menu Bar could not start config inspection: ${error.message}`);
    }
  }

  destroy() {
    this._destroyed = true;
    if (this._configTimeout)
      GLib.source_remove(this._configTimeout);
    this._configTimeout = 0;
    this._configProcess?.force_exit();
    this.menu.disconnect(this._menuSignal);
    super.destroy();
  }
});

function actorState(actor) {
  if (!actor)
    return null;
  return {
    visible: actor.visible,
    mapped: actor.mapped,
    width: actor.width,
    height: actor.height,
  };
}

// GNOME 46 / Ubuntu AppIndicators exposes each live SNI as a panel button.
// Keep that real button (including its menu, passive state and click handlers),
// but own the two product-name actors instead of depending on the optional
// Ayatana label bin's layout. Never create a button for an absent indicator.
// Unknown tray implementations are left untouched.
class NamedTrayLabels {
  constructor() {
    this._entries = new Map();
    this._refresh();
    // A small actor-only scan also covers AppIndicators enabled after this bar,
    // helper restarts and a native label bin recreated by a label update.
    // No subprocesses or D-Bus polling run in GNOME's render loop.
    this._source = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, 2, () => {
      this._refresh();
      return GLib.SOURCE_CONTINUE;
    });
  }

  _restoreNativeLabel(entry) {
    if (!entry.nativeBin)
      return;
    entry.nativeBin.disconnect(entry.nativeDestroyId);
    entry.nativeBin.visible = entry.nativeWasVisible;
    entry.nativeBin = null;
  }

  _hideNativeLabel(entry) {
    const bin = entry.actor._labelBin;
    if (bin !== entry.nativeBin) {
      this._restoreNativeLabel(entry);
      if (bin) {
        entry.nativeBin = bin;
        entry.nativeWasVisible = bin.visible;
        entry.nativeDestroyId = bin.connect('destroy', () => {
          entry.nativeBin = null;
        });
      }
    }
    entry.nativeBin?.hide();
  }

  _remove(actor) {
    const entry = this._entries.get(actor);
    if (!entry)
      return;
    this._entries.delete(actor);
    actor.disconnect(entry.destroyId);
    this._restoreNativeLabel(entry);
    entry.label.destroy();
  }

  _refresh() {
    const current = new Set();
    for (const actor of Object.values(Main.panel.statusArea)) {
      const name = actor?._indicator?.label;
      if (!NAMED_TRAYS.includes(name) || !actor._box?.add_child)
        continue;
      current.add(actor);
      let entry = this._entries.get(actor);
      if (!entry) {
        const label = new St.Label({text: name, y_align: 2, style_class: 'reddb-tray-name'});
        actor._box.add_child(label);
        entry = {actor, label, name, nativeBin: null};
        entry.destroyId = actor.connect('destroy', () => {
          // Its child actors are already being destroyed. Do not touch them.
          this._entries.delete(actor);
        });
        this._entries.set(actor, entry);
      }
      entry.name = name;
      entry.label.set_text(name);
      this._hideNativeLabel(entry);
    }
    for (const actor of this._entries.keys()) {
      if (!current.has(actor))
        this._remove(actor);
    }
  }

  status() {
    // "registered" refers to the existing tray actor, not daemon health.
    // Mapped + allocated is render evidence, not a screenshot or proof that
    // another window / monitor configuration cannot obscure the panel.
    return NAMED_TRAYS.map(name => {
      const entries = [...this._entries.values()].filter(entry => entry.name === name);
      return {
        name,
        registered: entries.length > 0,
        actors: entries.map(entry => ({
          label: {...actorState(entry.label), text: entry.label.get_text()},
          indicator: actorState(entry.actor),
        })),
      };
    });
  }

  destroy() {
    if (this._source)
      GLib.source_remove(this._source);
    this._source = 0;
    for (const actor of this._entries.keys())
      this._remove(actor);
  }
}

export default class RedDbBarExtension extends Extension {
  enable() {
    this._brand = new RedDbMenu(this, {
      restart: name => this._serviceMonitor?.restart(name),
      log: name => openServiceLog(name),
    });
    this._workspaces = new WorkspaceMenu();
    this._agents = new AgentsMenu();

    Main.panel.add_style_class_name('reddb-panel');
    Main.panel.addToStatusArea('reddb-menu', this._brand, 0, 'left');
    Main.panel.addToStatusArea('reddb-workspaces', this._workspaces, 1, 'left');
    Main.panel.addToStatusArea('reddb-agents', this._agents, 0, 'right');

    this._activities = Main.panel.statusArea.activities?.container ?? null;
    this._activities?.hide();

    this._trayNames = new NamedTrayLabels();
    this._serviceMonitor = new ServiceMonitor(units => this._brand?.setServices(units));
    this._updates = new UpdateWatcher(tools => this._brand?.setUpdates(tools));
    this._resources = new ResourceMonitor(state => this._brand?.setResources(state));
    this._runtime = Gio.DBusExportedObject.wrapJSObject(RUNTIME_INTERFACE, {
      Get: () => JSON.stringify({
        revision: RUNTIME_REVISION,
        menu: actorState(this._brand),
        indicators: this._trayNames.status(),
        services: this._serviceMonitor.status(),
        updates: this._updates.status(),
        resources: this._resources.status(),
      }),
    });
    this._runtime.export(Gio.DBus.session, RUNTIME_PATH);
  }

  disable() {
    this._runtime?.unexport();
    this._runtime = null;
    this._resources?.destroy();
    this._resources = null;
    this._updates?.destroy();
    this._updates = null;
    this._serviceMonitor?.destroy();
    this._serviceMonitor = null;
    this._trayNames?.destroy();
    this._trayNames = null;
    this._activities?.show();
    this._activities = null;
    this._agents?.destroy();
    this._agents = null;
    this._workspaces?.destroy();
    this._workspaces = null;
    this._brand?.destroy();
    this._brand = null;
    Main.panel.remove_style_class_name('reddb-panel');
  }
}

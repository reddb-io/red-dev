.reddb-panel {
  background-color: rgba(7, 8, 10, 0.94);
  box-shadow: inset 0 -1px rgba(255, 255, 255, 0.08);
}

.reddb-panel-button {
  border-radius: 9px;
  margin: 3px 2px;
  padding: 0 7px;
}

.reddb-panel-button:hover,
.reddb-panel-button:active,
.reddb-panel-button:checked {
  background-color: rgba(255, 255, 255, 0.12);
}

.reddb-brand,
.reddb-agents {
  spacing: 6px;
}

.reddb-brand-icon {
  icon-size: 18px;
}

.reddb-workspaces-label {
  font-weight: 700;
  letter-spacing: 1px;
}

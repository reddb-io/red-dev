{
  "name": "red-dev",
  "version": "0.23.16",
  "description": "One dev environment across Ubuntu 24, Ubuntu 26, WSL and Windows",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:linux": "bun build src/main.ts --compile --define process.env.NODE_ENV=\"\\\"production\\\"\" --target=bun-linux-x64 --outfile dist/red-dev-linux-x64",
    "build:windows": "bun build src/main.ts --compile --define process.env.NODE_ENV=\"\\\"production\\\"\" --target=bun-windows-x64 --outfile dist/red-dev-windows-x64.exe",
    "build": "bun run build:linux && bun run build:windows",
    "build:debug": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/red-dev-debug",
    "smoke": "bun build scripts/tui-smoke.ts --compile --target=bun-linux-x64 --outfile dist/tui-smoke && ./dist/tui-smoke"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cli-args-parser": "^1.0.6",
    "tuiuiu.js": "1.0.75"
  }
}

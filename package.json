{
  "name": "red-dev",
  "version": "0.1.0",
  "description": "One dev environment across Ubuntu 24, Ubuntu 26, WSL and Windows",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:linux": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/red-linux-x64",
    "build:windows": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile dist/red-windows-x64.exe",
    "build": "bun run build:linux && bun run build:windows"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
